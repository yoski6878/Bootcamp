<apex:page docType="html-5.0" showHeader="false" sidebar="false" applyHtmlTag="false" applyBodyTag="false" cache="false">
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="Yoseph Kinfu — Senior Consultant | Senior Salesforce Developer | Solution Architect" />
  <title>Yoseph Kinfu — Resume</title>
  <style>
    :root{
      --bg:#ffffff;
      --ink:#111827;
      --muted:#6b7280;
      --panel:#374151;        /* dark slate */
      --panel-ink:#f9fafb;    /* near-white */
      --panel-muted:#cbd5e1;
      --rule:rgba(255,255,255,.14);
      --rule2:#e5e7eb;
      --accent:#111827;
      --accent2:#2563eb;
      --max: 980px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      background:#eef2f7 radial-gradient(circle at 20% 20%, rgba(37,99,235,.08), transparent 36%),
                 radial-gradient(circle at 80% 10%, rgba(111,114,185,.08), transparent 30%);
      color:var(--ink);
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      line-height:1.45;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Page */
    .sheet{
      max-width:var(--max);
      margin: 32px auto;
      background:var(--bg);
      box-shadow: 0 18px 36px rgba(0,0,0,.12);
      border-radius: 16px;
      overflow:hidden;
      display:grid;
      grid-template-columns: 320px 1fr;
      min-height: 920px;
      animation: fadeInUp .7s ease;
    }

    /* Left panel */
    aside{
      background:linear-gradient(180deg, #1f2937 0%, #111827 70%);
      color:var(--panel-ink);
      padding: 28px 22px;
    }
    .photo-wrap{
      display:flex;
      justify-content:center;
      margin-top: 6px;
      margin-bottom: 18px;
    }
    .photo{
      width: 150px;
      height: 150px;
      border-radius: 999px;
      border: 6px solid rgba(255,255,255,.18);
      background:
        radial-gradient(circle at 30% 25%, rgba(255,255,255,.25), rgba(255,255,255,0) 55%),
        linear-gradient(135deg, rgba(255,255,255,.12), rgba(255,255,255,0));
      overflow:hidden;
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
      animation: float 4.5s ease-in-out infinite;
      box-shadow: 0 12px 22px rgba(0,0,0,.25);
    }
    .photo::after{
      content: "Add your photo";
      font-weight: 800;
      font-size: 13px;
      letter-spacing:.02em;
      color: var(--panel-muted);
      text-align:center;
      padding: 0 14px;
      line-height: 1.35;
      text-shadow: 0 4px 10px rgba(0,0,0,.18);
      animation: pulse 2.8s ease-in-out infinite;
    }

    .panel-section{
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--rule);
    }
    .panel-title{
      font-size: 22px;
      letter-spacing:.01em;
      margin: 0 0 10px 0;
      font-weight: 800;
    }
    .panel-item{
      margin: 10px 0;
    }
    .label{
      font-weight: 800;
      font-size: 13px;
      letter-spacing:.02em;
      text-transform: none;
      margin: 0 0 2px 0;
      color: var(--panel-ink);
    }
    .value{
      font-size: 13px;
      color: var(--panel-muted);
      margin: 0;
      word-break: break-word;
    }
    .value a{ color: var(--panel-muted); text-decoration:none }
    .value a:hover{ text-decoration:underline }

    .bullets{
      margin: 10px 0 0 0;
      padding: 0 0 0 16px;
      color: var(--panel-muted);
      font-size: 13px;
    }
    .bullets li{ margin: 7px 0 }

    /* Right content */
    main{
      padding: 30px 34px 34px;
      background: linear-gradient(160deg, rgba(37,99,235,.04) 0%, rgba(255,255,255,0) 28%),
                  linear-gradient(40deg, rgba(17,24,39,.04) 16%, rgba(255,255,255,0) 42%);
    }
    .top-bar{
      display:flex;
      justify-content:flex-end;
      margin-bottom: 8px;
    }
    .print-btn{
      border: 1px solid var(--rule2);
      background:#fff;
      color: var(--accent);
      padding: 8px 14px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 12.5px;
      letter-spacing:.02em;
      display:inline-flex;
      gap: 8px;
      align-items:center;
      cursor:pointer;
      box-shadow: 0 8px 16px rgba(0,0,0,.06);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .print-btn:hover{
      transform: translateY(-1px);
      border-color: var(--accent2);
      box-shadow: 0 12px 20px rgba(37,99,235,.18);
    }
    .print-btn svg{
      width:16px;
      height:16px;
      fill: currentColor;
    }
    header{
      padding-bottom: 14px;
      border-bottom: 2px solid var(--rule2);
      margin-bottom: 16px;
      animation: fadeIn .6s ease;
    }
    h1{
      margin:0;
      font-size: 44px;
      line-height: 1.05;
      letter-spacing: -0.02em;
      font-weight: 900;
      color: var(--accent);
    }
    .headline{
      margin: 8px 0 0 0;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: .06em;
      text-transform: uppercase;
      font-size: 12px;
    }
    .summary{
      margin-top: 10px;
      color:#374151;
      font-size: 13.5px;
      max-width: 68ch;
    }

    .section{
      margin-top: 18px;
    }
    .section h2{
      margin:0 0 10px 0;
      font-size: 22px;
      letter-spacing:.01em;
      font-weight: 900;
      color: var(--accent);
    }
    .divider{
      height:2px;
      background: linear-gradient(90deg, rgba(37,99,235,.36), rgba(37,99,235,.08) 44%, rgba(17,24,39,.06) 100%);
      margin: 8px 0 10px;
      position: relative;
      overflow: hidden;
    }
    .divider::after{
      content:"";
      position:absolute;
      inset:0;
      background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.55), rgba(255,255,255,0));
      transform: translateX(-120%);
      animation: shimmer 2.4s ease-in-out infinite;
    }

    /* Timeline experience */
    .timeline{
      position:relative;
      margin-top: 6px;
      padding-left: 22px;
    }
    .timeline:before{
      content:"";
      position:absolute;
      top: 2px;
      bottom: 4px;
      left: 6px;
      width: 2px;
      background: var(--rule2);
    }
    .event{
      position:relative;
      padding: 0 0 14px 0;
      margin-left: 8px;
      opacity:0;
      transform: translateY(18px);
      transition: opacity .45s ease, transform .45s ease;
    }
    .event.visible{
      opacity:1;
      transform: translateY(0);
    }
    .event:last-child{ padding-bottom: 0; }
    .dot{
      position:absolute;
      left: -18px;
      top: 3px;
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: #fff;
      border: 2px solid #9ca3af;
      box-shadow: 0 4px 8px rgba(0,0,0,.15);
    }
    .event-top{
      display:flex;
      gap: 10px;
      flex-wrap:wrap;
      align-items:baseline;
    }
    .dates{
      font-weight: 900;
      color:#6b7280;
      font-size: 12px;
      letter-spacing:.08em;
      text-transform: uppercase;
      min-width: 110px;
    }
    .company{
      font-weight: 900;
      color: var(--accent);
      font-size: 14px;
    }
    .role{
      font-weight: 800;
      color:#374151;
      font-size: 13px;
      margin-top: 2px;
    }
    .location{
      color: var(--muted);
      font-size: 12.5px;
    }
    .event p{
      margin: 8px 0 0 0;
      color:#4b5563;
      font-size: 13.2px;
    }
    .event ul{
      margin: 8px 0 0 0;
      padding-left: 18px;
      color:#4b5563;
      font-size: 13.2px;
    }
    .event li{ margin: 6px 0; }

    /* References (optional) */
    .refs{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px 18px;
      margin-top: 10px;
    }
    .ref{
      border-top: 1px solid var(--rule2);
      padding-top: 10px;
    }
    .ref strong{display:block}
    .ref span{display:block; color:var(--muted); font-size: 12.5px; margin-top: 2px}

    /* Responsive */
    @media (max-width: 860px){
      .sheet{grid-template-columns: 1fr}
      aside{border-bottom: 1px solid rgba(0,0,0,.06)}
      .top-bar{justify-content:flex-start;}
    }

    /* Print */
    @media print{
      body{background:inherit}
      .sheet{
        box-shadow:none;
        margin:0;
        border-radius:0;
        max-width: 100%;
        grid-template-columns: 320px 1fr;
        min-height: auto;
        animation:none;
      }
      .print-btn, .top-bar{display:none !important}
      a{color:inherit; text-decoration:none}
      *{-webkit-print-color-adjust: exact; print-color-adjust: exact;}
    }

    /* Animations */
    @keyframes fadeInUp{
      from{opacity:0; transform: translateY(18px);}
      to{opacity:1; transform: translateY(0);}
    }
    @keyframes fadeIn{
      from{opacity:0;}
      to{opacity:1;}
    }
    @keyframes float{
      0%{transform: translateY(0);}
      50%{transform: translateY(-6px);}
      100%{transform: translateY(0);}
    }
    @keyframes shimmer{
      0%{transform: translateX(-120%);}
      60%{transform: translateX(120%);}
      100%{transform: translateX(120%);}
    }
    @keyframes pulse{
      0%,100%{opacity:1; transform: translateY(0);}
      50%{opacity:.7; transform: translateY(-3px);}
    }
  </style>
</head>

